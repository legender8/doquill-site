DirectoryIndex index.html
Options -Indexes
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# French language routing
RewriteRule ^fr/$ fr/index.html [L]
RewriteRule ^fr/([^\.]+)$ fr/$1.html [NC,L]

# Remove .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Clean URL redirects (with .html → without)
RewriteCond %{THE_REQUEST} /index\.html
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} /([^.]+)\.html
RewriteRule ^ /%1 [R=301,L]

# Homepage
RewriteRule ^$ index.html [L]

# Enable Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS — force HTTPS for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Permissions Policy — disable unused browser features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=()"

  # Content Security Policy
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com https://embed.tawk.to https://*.tawk.to; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://*.tawk.to; font-src 'self' https://fonts.gstatic.com https://*.tawk.to; img-src 'self' data: https:; connect-src 'self' https://formspree.io https://app.doquill.io https://*.tawk.to wss://*.tawk.to; frame-src https://*.tawk.to; object-src 'none';"
</IfModule>

# Block sensitive source files from being served publicly
# (robots.txt is excluded so crawlers can still read it)
<FilesMatch "^(?!robots\.txt$).*\.(md|txt|json|log)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Block doc-source directory and root docs
<IfModule mod_rewrite.c>
  RewriteRule ^doc-source/ - [F,L]
  RewriteRule ^CLAUDE\.md - [F,L]
  RewriteRule ^README\.md - [F,L]
</IfModule>

# Custom 404 handler
ErrorDocument 404 /404.html
